# Normalise source line endings across platforms.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
*.shp binary
*.shx binary
*.dbf binary
*.gpkg binary
*.tif binary
*.zip binary

# Keep bytes used by the input and source checksum validation.
geo_data_prep/data/raw/** -text
RP1_Project/rp1_gee_ba_scripts/downloads/c3_release/** -text
RP1_Project/rp1_gee_ba_scripts/c3/** -text
